#!name = FPT Play Universal Bypass
#!desc = Mo khoa VIP FPT Play kem che do ghi log debug
#!author = dangtrunghieu

[Script]
fpt_universal_engine = type=http-response, pattern=^https?:\/\/.*\.fptplay\.(net|tv|com)\/api\/, script-path=https://raw.githubusercontent.com/dth2927/fptplay/main/fptplay_vip.js, requires-body=true, max-size=-1, timeout=10

[MITM]
hostname = %APPEND%, *.fptplay.net, *.fptplay.tv, *.fptplay.com
